# ---- Admin login (required for /admin) ----
# Password used at /admin/login (min 8 characters) and a long random string that signs the session cookie.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# ---- Supabase (optional until you create the project) ----
# Without these the admin stores data in ./.data (local development only).
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Secret key (sb_secret_…) from Project Settings → API Keys. Never expose it to the browser.
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=media

# ---- Telegram notifications (optional): new contact requests are pushed to this chat ----
# Create a bot with @BotFather, add it to the chat, then read the chat id from getUpdates.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
