# ---- Admin login (required for /admin) ----
# Password used at /admin/login (min 8 characters) and a long random string that signs the session cookie.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# ---- Supabase (optional until you create the project) ----
# Without these the admin stores data in ./.data (local development only).
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Secret key (sb_secret_…) from Project Settings → API Keys. Never expose it to the browser.
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=media

# ---- Cloudflare R2 (optional): photos and videos users upload in the online tools ----
# Without these, uploads go to public/uploads (local development only). Setup: docs/r2-setup.md
R2_ACCOUNT_ID=
# R2 API token with "Object Read & Write" on the bucket below. Never expose it to the browser.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=superlanding-uploads
# Public custom domain connected to the bucket, no trailing slash (not the rate-limited r2.dev URL).
R2_PUBLIC_URL=https://cdn.example.com

# ---- Telegram notifications (optional): new contact requests are pushed to this chat ----
# Create a bot with @BotFather, add it to the chat, then read the chat id from getUpdates.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
